{
  "compilerOptions": {   //behavior of the compiler TS
    "target": "ES2017",  //compile js until ES2017
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],  //apis that are available in the environment
    "allowJs": true,                //u can use also js files in the project
    "skipLibCheck": true,           //doesn't check type definitions of external libs
    "strict": true,                 //max security TS
    "noEmit": true,                 //ts doesnt generate js files, xk ts is only for type checking. Next.js use Babel / SWC x build
    "esModuleInterop": true,        //allow default imports from modules with no default export. better import/export compatibility
    "module": "esnext",             //output use ES modules, which support import/export syntax. Next.js uses this for tree shaking and better optimization
    "moduleResolution": "bundler",  //nextjs style resolution, simulate behavior of the bundler Webpack 
    "resolveJsonModule": true,      //allow importing json files as modules, useful for config files or data. e.g. import data from "./data.json";
    "isolatedModules": true,        //each file must be compiled as a separate module (quindi singolarmente). necessary x Babel / Nextjs
    "jsx": "react-jsx",             //use the new JSX transform introduced in React 17, which doesn't require importing React in every file that uses JSX. Next.js supports this for better performance and smaller bundle sizes.
    "incremental": true,            //ts save cache, so next time it only recompile changed files, faster builds
    "plugins": [
      {
        "name": "next"              //nextjs official plugin x ts
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]                             //alias @ to src, so u can import like import Button from "@/components/Button" instead of relative paths like import Button from "../../components/Button" !!
    }
  },
  "include": [                      //which files must be compiled
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [                     //which files must be ignored (dont analyzed) 
    "node_modules"
  ]
}
