//appsettings.Production.json
//su Coolify (production) setta auto ASPNETCORE_ENVIRONMENT=Production
/*
Su Coolify setti le variabili d'ambiente (override automatico dei placeholder):
  ConnectionStrings__sqlConnection  -> sostituisce PLACEHOLDER_DB_...
  JwtSettings__Audience             -> sostituisce PLACEHOLDER_HTTPS_FRONTEND_URL
  JwtSettings__SecretKey            -> sostituisce PLACEHOLDER_JWT_SECRET_KEY
  JwtSettings__AccessTokenExpiryMinutes  -> opzionale, default 10
  JwtSettings__RefreshTokenExpiryDays    -> opzionale, default 30
*/
{
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "sqlConnection": "Host=PLACEHOLDER_DB_HOST;Port=5432;Database=PLACEHOLDER_DB_NAME;Username=PLACEHOLDER_DB_USER;Password=PLACEHOLDER_DB_PASSWORD"
  },
  "JwtSettings": {
    "Issuer": "BusinessDev",
    "Audience": "PLACEHOLDER_HTTPS_FRONTEND_URL",
    "SecretKey": "PLACEHOLDER_JWT_SECRET_KEY",
    "AccessTokenExpiryMinutes": 10,
    "RefreshTokenExpiryDays": 30
  },
  "CloudflareR2": {
    "AccountId": "PLACEHOLDER_CF_ACCOUNT_ID",
    "BucketName": "assets",
    "AccessKey": "PLACEHOLDER_CF_R2_ACCESS_KEY",
    "SecretKey": "PLACEHOLDER_CF_R2_SECRET_KEY",
    "CdnBaseUrl": "https://cdn.substracker.live"
  }
  ,
  "Sentry": {
    "Dsn": "PLACEHOLDER_SENTRY_DSN"
    // su Coolify: Sentry__Dsn = incolla il DSN dalla dashboard Sentry (Settings > Projects > Client Keys)
  }
  /*
  in Coolify aggiungi variabili d'ambiente
  CloudflareR2__AccountId
  CloudflareR2__AccessKey
  CloudflareR2__SecretKey
  costruisci https://{accountId}.r2.cloudflarestorage.com in file ServiceCollectionExtensions.cs(94row) per poter fare UPLOAD IMG(access key + secretkey (R2 api token))
  */
}
