//appsettings.Staging.json
//ASPNETCORE_ENVIRONMENT=Staging
/*
Su Coolify (staging) setti le variabili d'ambiente:
  ConnectionStrings__sqlConnection  -> override del placeholder
  JwtSettings__SecretKey            -> override del placeholder
  JwtSettings__Audience             -> override del placeholder
*/
{
  "ConnectionStrings": {
    "sqlConnection": "Host=PLACEHOLDER_STAGING_DB_HOST;Port=5432;Database=PLACEHOLDER_STAGING_DB_NAME;Username=PLACEHOLDER_STAGING_DB_USER;Password=PLACEHOLDER_STAGING_DB_PASSWORD"
  },
  "JwtSettings": {
    "Issuer": "BusinessDev",
    "Audience": "PLACEHOLDER_HTTPS_STAGING_FRONTEND_URL",
    "SecretKey": "PLACEHOLDER_STAGING_JWT_SECRET_KEY",
    "AccessTokenExpiryMinutes": 10,
    "RefreshTokenExpiryDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
